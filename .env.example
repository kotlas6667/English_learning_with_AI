# --- TTS: edge (Microsoft Edge Voices, bez kľúča) | elevenlabs ---
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-JennyNeural
SPEECH_RATE=1.0

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- LLM text providers (at least one required) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
